# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# Required: your LinkedIn session cookie.
# How to get it:
#   1. Log into linkedin.com normally in Chrome/Firefox with your own account.
#   2. Open DevTools -> Application tab -> Cookies -> https://www.linkedin.com
#   3. Copy the value of the "li_at" cookie below.
LI_AT_COOKIE=

# Required in practice: JSESSIONID cookie value, used to build the
# csrf-token header Voyager requires. Copy it the same way as li_at above
# (include or omit the surrounding quotes, either works — the code
# normalizes it).
LI_JSESSIONID_COOKIE=

# Strongly recommended when deployed: outbound proxy for the LinkedIn calls.
# LinkedIn flags datacenter IPs (Render/Fly/cloud) within a request or two
# and kills the session. Route through a residential/mobile proxy instead.
# Full proxy URL, e.g. http://user:pass@gate.smartproxy.com:7000
# Leave blank for local runs from a home IP.
OUTBOUND_PROXY=
