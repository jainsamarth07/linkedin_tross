# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# Required: your LinkedIn session cookie.
# How to get it:
#   1. Log into linkedin.com normally in Chrome/Firefox with your own account.
#   2. Open DevTools -> Application tab -> Cookies -> https://www.linkedin.com
#   3. Copy the value of the "li_at" cookie below.
LI_AT_COOKIE=

# Optional but recommended: JSESSIONID cookie value, used to build the
# csrf-token header Voyager requires on requests. Copy it the same way as
# li_at above (include or omit the surrounding quotes, either works — the
# code normalizes it).
LI_JSESSIONID_COOKIE=
