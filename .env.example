# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# ── LinkedIn session ────────────────────────────────────────────────────────
# Preferred: the FULL `cookie:` header from a real logged-in browser request.
# DevTools -> Network -> right-click any www.linkedin.com request ->
# Copy -> Copy as cURL -> paste the `-b '…'` / `-H 'cookie: …'` value here as
# ONE line (~15 cookies: li_at, JSESSIONID, bcookie, lidc, _px3, …).
# The app parses JSESSIONID out of it for the csrf-token header.
LI_COOKIE_STRING=

# Fallback, used only if LI_COOKIE_STRING is empty. Thinner / more bot-like.
# li_at (long string, does NOT start with "ajax:") and JSESSIONID
# ("ajax:123…", quotes optional) from the SAME login.
LI_AT_COOKIE=
LI_JSESSIONID_COOKIE=

# ── Deployment ──────────────────────────────────────────────────────────────
# Optional residential/mobile proxy for the LinkedIn calls. Datacenter IPs
# (Render/Fly/…) are lower-trust, but in testing the SDUI path still worked
# from Render with this left blank. Set it for sustained volume, or if a cloud
# host starts returning 401. Full URL, e.g. http://user:pass@gate.example.com:7000.
OUTBOUND_PROXY=

# Optional. "0" = skip the About/Experience/Education/Skills rsc-action calls
# and return the top card only (1 request instead of 5). Default: on.
FETCH_DETAIL_CARDS=

# Optional. curl_cffi TLS/HTTP2 impersonation target. Default: chrome136.
IMPERSONATE_TARGET=
